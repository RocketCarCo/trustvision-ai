# TrustVision AI - Environment Configuration
# Copy this file to .env and customize as needed

# =============================================================================
# Application Settings
# =============================================================================
APP_NAME=TrustVision AI
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# =============================================================================
# Server Configuration
# =============================================================================
HOST=0.0.0.0
PORT=8000

# =============================================================================
# Device Configuration
# =============================================================================
# Options: cpu, cuda (NVIDIA GPU), mps (Apple Silicon)
DEVICE=cpu

# =============================================================================
# Model Configuration
# =============================================================================
# Whisper model size: tiny, base, small, medium, large
# Smaller = faster but less accurate
# Larger = slower but more accurate
WHISPER_MODEL=base

# Deepfake detection model from HuggingFace
DEEPFAKE_MODEL=dima806/deepfake_vs_real_image_detection

# =============================================================================
# Path Configuration
# =============================================================================
MODEL_CACHE_DIR=./models
UPLOAD_DIR=./uploads
SAMPLES_DIR=./samples

# =============================================================================
# Processing Settings
# =============================================================================
# Frame sampling rate (seconds between sampled frames)
FRAME_SAMPLE_RATE=2

# Maximum video duration (seconds)
MAX_VIDEO_DURATION=300

# Maximum file size (MB)
MAX_FILE_SIZE_MB=100

# =============================================================================
# Detection Thresholds
# =============================================================================
# Minimum blinks required for liveness
MIN_BLINK_COUNT=2

# Head movement threshold
MIN_HEAD_MOVEMENT_THRESHOLD=0.02

# Confidence thresholds (0.0 - 1.0)
LIVENESS_CONFIDENCE_THRESHOLD=0.7
DEEPFAKE_CONFIDENCE_THRESHOLD=0.7
LIP_SYNC_THRESHOLD=0.6
